# Dockerfile.dispatcher — FastAPI service on uvicorn.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
 && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY packages/dispatcher ./packages/dispatcher

# The dispatcher's workspace root pyproject references packages/engine as a
# workspace member. We don't need the engine package files to resolve the
# dispatcher's own deps, but uv workspace validation may require the dir
# structure. Create a stub to satisfy workspace resolution:
RUN mkdir -p packages/engine/src/a2sdlc && \
    touch packages/engine/src/a2sdlc/__init__.py && \
    printf '[project]\nname = "a2sdlc-engine"\nversion = "0.0.0"\ndescription = "stub"\nrequires-python = ">=3.12"\ndependencies = []\n\n[build-system]\nrequires = ["hatchling"]\nbuild-backend = "hatchling.build"\n\n[tool.hatch.build.targets.wheel]\npackages = ["src/a2sdlc"]\n' > packages/engine/pyproject.toml

RUN uv sync --package a2sdlc-dispatcher --no-dev --frozen

EXPOSE 8000
ENTRYPOINT ["uv", "run", "--package", "a2sdlc-dispatcher", "--no-dev", "a2sdlc-dispatcher"]
