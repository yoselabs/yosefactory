{
  "// --- File tree visibility ---": "Hide caches and build artefacts from the explorer",
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.ty_cache": true,
    "**/.mypy_cache": true,
    "**/.coverage": true,
    "**/htmlcov": true,
    "**/coverage.xml": true,
    "**/*.egg-info": true,
    "**/.DS_Store": true,
    "**/node_modules": true
  },

  "// --- Search scope ---": "Additionally skip these in global search",
  "search.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.ty_cache": true,
    "**/.mypy_cache": true,
    "**/htmlcov": true,
    "**/.venv": true,
    "**/venv": true,
    "**/dist": true,
    "**/build": true,
    "**/*.egg-info": true,
    "**/uv.lock": true,
    "**/poetry.lock": true
  },

  "// --- File watcher (avoids CPU spikes on caches) ---": "",
  "files.watcherExclude": {
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.ty_cache/**": true,
    "**/.venv/**": true,
    "**/htmlcov/**": true
  },

  "// --- Python interpreter ---": "Project venv; adjust if you use a different path",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,

  "// --- Testing ---": "",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  "// --- Editor basics ---": "",
  "editor.formatOnSave": true,
  "editor.rulers": [100, 120],
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  "// --- Python-specific formatting via Ruff ---": "",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },

  "// --- YAML / JSON / Markdown nicety ---": "",
  "[yaml]": { "editor.tabSize": 2 },
  "[json]": { "editor.tabSize": 2 },
  "[jsonc]": { "editor.tabSize": 2 },
  "[markdown]": {
    "editor.wordWrap": "on",
    "files.trimTrailingWhitespace": false
  }
}
